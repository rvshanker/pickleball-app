{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**"
    ],
    "redirects": [
      {
        "source": "/dp/**",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      { "source": "/fetch-price", "function": "fetchPrice" },
      { "source": "/search", "function": "searchCatalog" },
      { "source": "/admin-seed", "function": "adminSeedCatalog" },
      { "source": "/admin-refresh", "function": "adminRefreshAll" }
    ]
  }
}
